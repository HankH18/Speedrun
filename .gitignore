# --- Speedrun additions ---

# Local collections and personal review data
*.anki2
*.anki2-wal
*.anki2-shm

# Held-out evaluation sets must never enter training data
data/holdout/

# Gated review dataset (open-spaced-repetition/anki-revlogs-10k). Downloaded by
# speedrun-analysis/appendix_b/fetch_dataset.py, which refuses to write anywhere
# `git check-ignore` does not already cover. Its licence says "please do not
# redistribute the data publicly", so no byte of it -- and no manifest describing
# it -- may enter this history. See appendix_b/DATASET-PROVENANCE.md.
/speedrun-analysis/appendix_b/data/
*.parquet

# Carried over from Speedrun's pre-merge .gitignore. Not in the four rules
# specified for the merge, but dropping them would be a regression: .env in
# particular guards against committing secrets.
*.apkg
*.colpkg
.env

# Tagger output: derived from the user's deck and quotes its note text.
# Regenerate with speedrun-analysis/deck/tag_deck.py; never commit it.
speedrun-analysis/deck/out/
